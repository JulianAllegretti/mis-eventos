# Copia este archivo a .env y ajusta los valores. .env no se versiona.

# --- PostgreSQL ---
POSTGRES_USER=miseventos
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=miseventos

# --- Backend ---
DATABASE_URL=postgresql+psycopg://miseventos:cambia-esta-clave@db:5432/miseventos
REDIS_URL=redis://redis:6379/0
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"  (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# En desarrollo local sin HTTPS pon false. En producción debe ser true.
COOKIE_SECURE=false
# Orígenes que pueden enviar peticiones con la cookie de sesión (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Primer administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Segundos entre ejecuciones del cierre automático de eventos vencidos (0 = desactivado)
FINISH_JOB_INTERVAL_SECONDS=60
# TTL de la caché de lectura de eventos
CACHE_TTL_SECONDS=60
# Intentos de login fallidos permitidos por ventana (por correo y por IP)
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900
LOG_LEVEL=INFO

# --- Observabilidad (solo con: docker compose --profile observability up) ---
GRAFANA_ADMIN_USER=admin
# Obligatoria para el perfil observability: sin ella Grafana usaría la clave por defecto.
GRAFANA_ADMIN_PASSWORD=
